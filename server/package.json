{
  "name": "acrm-market-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:schema": "tsx db/apply-schema.ts",
    "db:seed": "tsx db/seed.ts",
    "test": "tsx --test --test-concurrency=1 test/unit.test.ts test/api.test.ts",
    "test:unit": "tsx --test test/unit.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
