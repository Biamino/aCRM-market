# /etc/acrm-market/asdem.env — asdem.shop (только CRM Asdem 1 / crm_v1)
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acrm_market
DB_PASSWORD=<как в /etc/acrm-market.env>
JWT_SECRET=<как в /etc/acrm-market.env — чтобы не разлогинить текущих пользователей>
SITE_URL=https://asdem.shop
SITE_NAME=ASDEM
ACCOUNTS_DB_NAME=crm_v1
CLIENT_DIST=/opt/acrm-market/client/dist-asdem
UPLOAD_DIR=/var/lib/acrm-market/asdem/uploads
BRANCHES='[{"id":"asdem1","name":"Asdem 1","db":"crm_v1","crmUploadDir":"/opt/crm-backend/uploads","crmApiOrigin":"https://crm.asdem.shop"}]'
