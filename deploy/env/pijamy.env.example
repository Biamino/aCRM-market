# /etc/acrm-market/pijamy.env — asdem-pijamy.shop (только CRM Dordoi / crm_dordoi)
NODE_ENV=production
HOST=127.0.0.1
PORT=4001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acrm_pijamy
DB_PASSWORD=<новый пароль>
JWT_SECRET=<новый: openssl rand -hex 32>
SITE_URL=https://asdem-pijamy.shop
SITE_NAME="ASDEM Пижамы"
ACCOUNTS_DB_NAME=crm_dordoi
CLIENT_DIST=/opt/acrm-market/client/dist-pijamy
UPLOAD_DIR=/var/lib/acrm-market/pijamy/uploads
# id "asdem2" не менять: он в web_account_customers и в ссылках на фото
BRANCHES='[{"id":"asdem2","name":"Asdem 2","db":"crm_dordoi","crmUploadDir":"/opt/crm-dordoi/uploads","crmApiOrigin":"https://dordoi.space"}]'
